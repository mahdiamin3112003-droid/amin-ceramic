# AMIN CERAMIC — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never commit a real value here.
#
# Phase 0 needs the database and Supabase blocks only. Cloudinary, Upstash,
# Resend, Inngest, Sentry, PostHog and the AI providers arrive in later phases
# and are listed at the bottom so the shape is known, not so they get filled in.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL is the POOLED connection (pgbouncer, transaction mode, port 6543),
# as the postgres superuser. Prisma CLI (migrate/seed) uses this; the app's own
# runtime queries do NOT — see RUNTIME_DATABASE_URL below. `connection_limit=1`
# is required on serverless: each function instance gets its own connection,
# and a higher limit exhausts the pooler rather than helping.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is the DIRECT connection (port 5432). Migrations and the seed only —
# pgbouncer in transaction mode cannot run DDL or hold session state.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# The app's OWN runtime connection — a dedicated non-superuser role
# (prisma/migrations/*_app_runtime_role), NOT the postgres user above.
# Postgres never applies row-level security to superusers, so every
# request-time query must run as a role RLS actually constrains. Set the
# role's password once via `ALTER ROLE app_runtime PASSWORD '...'` against
# the project — it is never stored in a migration file.
#
# `connection_limit=5`, NOT 1. Every RLS-scoped read runs inside its own
# `withRequestContext` transaction, and Next renders a layout and its page
# CONCURRENTLY — the site header's basket/wishlist reads genuinely race the
# page's. At limit 1 those serialise behind one connection and a
# multi-section page (the homepage does five) exceeds `pool_timeout`,
# failing with P2024/P2028. 5 is still far below what the pooler allows per
# client while letting a page's reads actually proceed in parallel.
RUNTIME_DATABASE_URL="postgresql://app_runtime.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"

# Publishable / anon key. Safe in the client bundle; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Secret / service-role key. BYPASSES RLS. Server-side jobs only — ingestion,
# embeddings, rollups, outbox drain. CI fails the build if this string appears
# in any client chunk (docs/01-architecture.md §8.3).
SUPABASE_SERVICE_ROLE_KEY=""

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, for hreflang alternates and absolute OG URLs. On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL automatically; set it once a real
# domain exists.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# HMAC key signing the ac_vid visitor cookie (docs/04-api-architecture.md §4.2).
# A client that could forge another visitor's id could read/write their saved
# items and open quote — generate with `openssl rand -base64 32`, never share.
VISITOR_COOKIE_SECRET=""

# ── Later phases — listed for shape, not to be filled in now ────────────────
# CLOUDINARY_URL=                 # Phase 2, media
# UPSTASH_REDIS_REST_URL=         # Phase 2, cache and rate limits
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=                 # Phase 9, transactional email
# INNGEST_EVENT_KEY=              # Phase 8, ingestion workflows
# INNGEST_SIGNING_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # Phase 5, vision and extraction
# OPENAI_API_KEY=                 # Phase 5, text embeddings
# SENTRY_DSN=                     # Phase 9
# NEXT_PUBLIC_POSTHOG_KEY=        # Phase 9
